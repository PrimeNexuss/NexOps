<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "NexOps - Security Operations Platform" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="NexOps">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <body class="auth-body">
    <!-- Background Animation -->
    <div class="auth-background">
      <div class="floating-elements">
        <div class="floating-element"></div>
        <div class="floating-element"></div>
        <div class="floating-element"></div>
        <div class="floating-element"></div>
        <div class="floating-element"></div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="auth-container">
      <!-- Logo/Brand Section -->
      <div class="auth-brand">
        <div class="brand-logo">
          <div class="logo-icon">></div>
          <h1>NexOps</h1>
        </div>
        <p class="brand-tagline">Advanced Security Operations Platform</p>
      </div>

      <!-- Flash Messages -->
      <% if notice %>
        <div class="alert alert-success fade-in">
          <%= notice %>
        </div>
      <% end %>
      
      <% if alert %>
        <div class="alert alert-warning fade-in">
          <%= alert %>
        </div>
      <% end %>

      <!-- Form Content -->
      <div class="auth-form-container">
        <%= yield %>
      </div>

      <!-- Footer -->
      <div class="auth-footer">
        <p>&copy; 2026 NexOps. Secure. Professional. Advanced.</p>
      </div>
    </div>
  </body>
</html>

<style>
.auth-body {
  background: var(--dark-bg);
  color: var(--text-primary);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  min-height: 100vh;
  overflow-x: hidden;
}

.auth-background {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--gradient-dark);
  z-index: -1;
}

.floating-elements {
  position: absolute;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.floating-element {
  position: absolute;
  background: var(--gradient-primary);
  border-radius: 50%;
  opacity: 0.1;
  animation: float 20s infinite ease-in-out;
}

.floating-element:nth-child(1) {
  width: 80px;
  height: 80px;
  left: 10%;
  top: 20%;
  animation-delay: 0s;
}

.floating-element:nth-child(2) {
  width: 120px;
  height: 120px;
  right: 15%;
  top: 60%;
  animation-delay: 2s;
}

.floating-element:nth-child(3) {
  width: 60px;
  height: 60px;
  left: 70%;
  top: 10%;
  animation-delay: 4s;
}

.floating-element:nth-child(4) {
  width: 100px;
  height: 100px;
  right: 30%;
  bottom: 20%;
  animation-delay: 6s;
}

.floating-element:nth-child(5) {
  width: 40px;
  height: 40px;
  left: 50%;
  top: 50%;
  animation-delay: 8s;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) rotate(0deg);
  }
  25% {
    transform: translateY(-20px) rotate(90deg);
  }
  50% {
    transform: translateY(0) rotate(180deg);
  }
  75% {
    transform: translateY(20px) rotate(270deg);
  }
}

.auth-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 2rem;
  position: relative;
  z-index: 1;
}

.auth-brand {
  text-align: center;
  margin-bottom: 3rem;
}

.brand-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  margin-bottom: 1rem;
}

.logo-icon {
  width: 60px;
  height: 60px;
  background: var(--gradient-primary);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  font-weight: bold;
  box-shadow: 0 8px 20px rgba(99, 102, 241, 0.3);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.brand-logo h1 {
  font-size: 2.5rem;
  font-weight: 800;
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin: 0;
}

.brand-tagline {
  color: var(--text-secondary);
  font-size: 1.1rem;
  margin: 0;
  opacity: 0.8;
}

.auth-form-container {
  width: 100%;
  max-width: 420px;
}

.auth-footer {
  text-align: center;
  margin-top: 3rem;
  color: var(--text-secondary);
  opacity: 0.6;
}

@media (max-width: 768px) {
  .auth-container {
    padding: 1rem;
  }
  
  .brand-logo h1 {
    font-size: 2rem;
  }
  
  .logo-icon {
    width: 50px;
    height: 50px;
    font-size: 1.2rem;
  }
  
  .brand-tagline {
    font-size: 1rem;
  }
  
  .auth-form-container {
    max-width: 100%;
  }
}
</style>
