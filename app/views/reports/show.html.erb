<% content_for :title, "Report ##{@report.id} - NexOps" %>

<div class="container">
  <div class="d-flex justify-between align-center mb-5">
    <div>
      <h1>Security Report ##{@report.id}</h1>
      <p class="text-secondary">
        Operation: <%= link_to @operation.name, @operation, class: "text-primary" %> | 
        Generated: <%= @report.generated_at.strftime('%B %d, %Y at %I:%M %p') %>
      </p>
    </div>
    <div class="d-flex gap-3">
      <%= link_to "Edit Report", "#", class: "btn btn-outline" %>
      <%= link_to "PDF", export_pdf_report_path(@report), class: "btn btn-primary" %>
      <%= link_to "CSV", export_csv_report_path(@report), class: "btn btn-secondary" %>
    </div>
  </div>

  <!-- Executive Summary -->
  <div class="grid grid-cols-2 gap-4 mb-5">
    <div class="card">
      <h2>Executive Summary</h2>
      <div class="summary-grid">
        <div class="summary-item">
          <div class="summary-value"><%= @targets.count %></div>
          <div class="summary-label">Total Targets</div>
        </div>
        <div class="summary-item">
          <div class="summary-value"><%= @findings.count %></div>
          <div class="summary-label">Total Findings</div>
        </div>
        <div class="summary-item">
          <div class="summary-value text-danger"><%= @critical_findings %></div>
          <div class="summary-label">Critical Issues</div>
        </div>
        <div class="summary-item">
          <div class="summary-value text-success"><%= @verified_findings %></div>
          <div class="summary-label">Verified Findings</div>
        </div>
      </div>
    </div>

    <div class="card">
      <h2>Findings by Severity</h2>
      <div class="severity-chart">
        <div class="severity-bar">
          <div class="bar-segment critical" style="width: <%= @findings.count > 0 ? (@critical_findings.to_f / @findings.count * 100).round : 0 %>%">
            <span class="bar-label">Critical</span>
          </div>
          <div class="bar-segment high" style="width: <%= @findings.count > 0 ? (@high_findings.to_f / @findings.count * 100).round : 0 %>%">
            <span class="bar-label">High</span>
          </div>
          <div class="bar-segment medium" style="width: <%= @findings.count > 0 ? (@medium_findings.to_f / @findings.count * 100).round : 0 %>%">
            <span class="bar-label">Medium</span>
          </div>
          <div class="bar-segment low" style="width: <%= @findings.count > 0 ? (@low_findings.to_f / @findings.count * 100).round : 0 %>%">
            <span class="bar-label">Low</span>
          </div>
        </div>
        <div class="severity-legend">
          <div class="legend-item">
            <span class="legend-color critical"></span>
            <span class="legend-text">Critical (<%= @critical_findings %>)</span>
          </div>
          <div class="legend-item">
            <span class="legend-color high"></span>
            <span class="legend-text">High (<%= @high_findings %>)</span>
          </div>
          <div class="legend-item">
            <span class="legend-color medium"></span>
            <span class="legend-text">Medium (<%= @medium_findings %>)</span>
          </div>
          <div class="legend-item">
            <span class="legend-color low"></span>
            <span class="legend-text">Low (<%= @low_findings %>)</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Targets Overview -->
  <div class="card mb-5">
    <h2>Targets Overview</h2>
    <div class="targets-table">
      <div class="table-header">
        <div class="table-cell">Target</div>
        <div class="table-cell">IP Address</div>
        <div class="table-cell">Findings</div>
        <div class="table-cell">Critical</div>
        <div class="table-cell">Status</div>
      </div>
      <% @targets.each do |target| %>
        <div class="table-row">
          <div class="table-cell">
            <%= link_to target.host_name, target_path(target), class: "text-primary" %>
          </div>
          <div class="table-cell"><%= target.ip_address %></div>
          <div class="table-cell"><%= target.findings.count %></div>
          <div class="table-cell text-danger"><%= target.findings.where(severity: 'critical').count %></div>
          <div class="table-cell">
            <% if target.state_compromise %>
              <span class="badge badge-danger">Compromised</span>
            <% else %>
              <span class="badge badge-success">Secure</span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Detailed Findings -->
  <div class="card">
    <div class="d-flex justify-between align-center mb-4">
      <h2>Detailed Findings</h2>
      <div class="d-flex gap-3">
        <select class="form-control" style="width: 120px;" onchange="filterFindings(this.value)">
          <option value="">All Severities</option>
          <option value="critical">Critical</option>
          <option value="high">High</option>
          <option value="medium">Medium</option>
          <option value="low">Low</option>
        </select>
        <select class="form-control" style="width: 120px;" onchange="filterFindings(this.value)">
          <option value="">All Status</option>
          <option value="verified">Verified</option>
          <option value="pending">Pending</option>
        </select>
      </div>
    </div>

    <% if @findings.any? %>
      <div class="findings-list" id="findings-list">
        <% @findings.each do |finding| %>
          <div class="finding-row" data-severity="<%= finding.severity %>" data-status="<%= finding.verified? ? 'verified' : 'pending' %>">
            <div class="finding-header">
              <div class="finding-info">
                <h3><%= link_to finding.title, finding_path(finding), class: "text-primary" %></h3>
                <p class="text-secondary"><%= finding.description %></p>
              </div>
              <div class="finding-badges">
                <span class="badge badge-<%= finding.severity == 'critical' ? 'danger' : finding.severity %>"><%= finding.severity.upcase %></span>
                <% if finding.verified? %>
                  <span class="badge badge-success">Verified</span>
                <% else %>
                  <span class="badge badge-warning">Pending</span>
                <% end %>
              </div>
            </div>
            
            <div class="finding-meta">
              <div class="meta-item">
                <span class="text-secondary">Target:</span>
                <span><%= link_to finding.target.host_name, finding.target, class: "text-primary" %></span>
              </div>
              <div class="meta-item">
                <span class="text-secondary">Tool:</span>
                <span><%= finding.tool&.name || 'Manual' %></span>
              </div>
              <div class="meta-item">
                <span class="text-secondary">Evidence:</span>
                <span><%= finding.evidence.count %> files</span>
              </div>
              <div class="meta-item">
                <span class="text-secondary">Created:</span>
                <span><%= finding.created_at.strftime('%B %d, %Y') %></span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center p-5">
        <h3>No Findings</h3>
        <p class="text-secondary">This operation has no security findings recorded.</p>
      </div>
    <% end %>
  </div>
</div>

<style>
.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}

.summary-item {
  text-align: center;
  padding: 1rem;
  background: var(--dark-bg);
  border-radius: 8px;
}

.summary-value {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 0.25rem;
}

.summary-label {
  font-size: 0.75rem;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.severity-chart {
  margin-top: 1rem;
}

.severity-bar {
  display: flex;
  height: 30px;
  border-radius: 6px;
  overflow: hidden;
  margin-bottom: 1rem;
}

.bar-segment {
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 0.75rem;
  font-weight: 600;
  transition: all 0.3s ease;
}

.bar-segment.critical {
  background: var(--danger);
}

.bar-segment.high {
  background: var(--warning);
}

.bar-segment.medium {
  background: var(--info);
}

.bar-segment.low {
  background: var(--success);
}

.severity-legend {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.5rem;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
}

.legend-color {
  width: 12px;
  height: 12px;
  border-radius: 2px;
}

.legend-color.critical { background: var(--danger); }
.legend-color.high { background: var(--warning); }
.legend-color.medium { background: var(--info); }
.legend-color.low { background: var(--success); }

.targets-table {
  border: 1px solid var(--dark-border);
  border-radius: 8px;
  overflow: hidden;
}

.table-header {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
  background: var(--dark-bg);
  font-weight: 600;
  padding: 1rem;
  border-bottom: 1px solid var(--dark-border);
}

.table-row {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
  padding: 1rem;
  border-bottom: 1px solid var(--dark-border);
  transition: all 0.3s ease;
}

.table-row:hover {
  background: rgba(99, 102, 241, 0.05);
}

.table-row:last-child {
  border-bottom: none;
}

.table-cell {
  display: flex;
  align-items: center;
  font-size: 0.875rem;
}

.findings-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.finding-row {
  background: var(--dark-bg);
  border: 1px solid var(--dark-border);
  border-radius: 8px;
  padding: 1.5rem;
  transition: all 0.3s ease;
}

.finding-row:hover {
  border-color: var(--primary-color);
}

.finding-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1rem;
}

.finding-info h3 {
  font-size: 1.125rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.finding-info p {
  color: var(--text-secondary);
  line-height: 1.4;
  margin: 0;
}

.finding-badges {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.finding-meta {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
  font-size: 0.875rem;
}

.meta-item {
  display: flex;
  justify-content: space-between;
}

@media (max-width: 768px) {
  .grid-cols-2 {
    grid-template-columns: 1fr;
  }
  
  .summary-grid {
    grid-template-columns: 1fr;
  }
  
  .severity-legend {
    grid-template-columns: 1fr;
  }
  
  .table-header, .table-row {
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }
  
  .table-cell {
    justify-content: space-between;
  }
  
  .finding-header {
    flex-direction: column;
    gap: 1rem;
  }
  
  .finding-badges {
    flex-direction: row;
  }
  
  .finding-meta {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
function filterFindings(severity) {
  const findings = document.querySelectorAll('.finding-row');
  
  findings.forEach(finding => {
    const findingSeverity = finding.dataset.severity;
    const findingStatus = finding.dataset.status;
    
    if (severity === '' || findingSeverity === severity) {
      finding.style.display = 'block';
    } else {
      finding.style.display = 'none';
    }
  });
}
</script>
