<% content_for :title, "Audit Logs - NexOps" %>

<div class="container">
  <div class="d-flex justify-between align-center mb-5">
    <div>
      <h1>Audit Logs</h1>
      <p class="text-secondary">System activity and audit trail</p>
    </div>
    <div class="d-flex gap-3">
      <%= link_to "Export Logs", "#", class: "btn btn-outline" %>
      <%= link_to "System Settings", "#", class: "btn btn-outline" %>
    </div>
  </div>

  <!-- Activity Summary -->
  <div class="grid grid-cols-4 mb-5">
    <div class="card stat-card">
      <div class="d-flex align-center gap-3">
        <div class="stat-icon large">></div>
        <div>
          <h2 class="text-primary"><%= @total_logs %></h2>
          <p class="text-secondary">Total Activities</p>
        </div>
      </div>
    </div>
    
    <div class="card stat-card">
      <div class="d-flex align-center gap-3">
        <div class="stat-icon large">></div>
        <div>
          <h2 class="text-success"><%= @activity_summary['create'] || 0 %></h2>
          <p class="text-secondary">Creates</p>
        </div>
      </div>
    </div>
    
    <div class="card stat-card">
      <div class="d-flex align-center gap-3">
        <div class="stat-icon large">></div>
        <div>
          <h2 class="text-warning"><%= @activity_summary['update'] || 0 %></h2>
          <p class="text-secondary">Updates</p>
        </div>
      </div>
    </div>
    
    <div class="card stat-card">
      <div class="d-flex align-center gap-3">
        <div class="stat-icon large">></div>
        <div>
          <h2 class="text-info"><%= @users.count %></h2>
          <p class="text-secondary">Active Users</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Search and Filters -->
  <div class="card mb-5">
    <h2>Search & Filter</h2>
    <form action="/audit_logs" method="get" class="search-form">
      <div class="grid grid-cols-1 gap-4">
        <div class="form-group">
          <label class="form-label">Search Query</label>
          <input type="text" 
                 name="q" 
                 value="<%= @query %>" 
                 class="form-control" 
                 placeholder="Search actions, resources, or details..."
                 autocomplete="off">
        </div>
        
        <div class="grid grid-cols-4 gap-4">
          <div class="form-group">
            <label class="form-label">User</label>
            <select name="user_id" class="form-control">
              <option value="">All Users</option>
              <% @users.each do |user| %>
                <option value="<%= user.id %>" <%= @filters[:user_id] == user.id.to_s ? 'selected' : '' %>>
                  <%= user.name %>
                </option>
              <% end %>
            </select>
          </div>
          
          <div class="form-group">
            <label class="form-label">Action</label>
            <select name="action" class="form-control">
              <option value="">All Actions</option>
              <% @actions.each do |action| %>
                <option value="<%= action %>" <%= @filters[:action] == action ? 'selected' : '' %>>
                  <%= action.humanize %>
                </option>
              <% end %>
            </select>
          </div>
          
          <div class="form-group">
            <label class="form-label">Resource Type</label>
            <select name="resource_type" class="form-control">
              <option value="">All Resources</option>
              <% @resource_types.each do |type| %>
                <option value="<%= type %>" <%= @filters[:resource_type] == type ? 'selected' : '' %>>
                  <%= type %>
                </option>
              <% end %>
            </select>
          </div>
          
          <div class="form-group">
            <button type="submit" class="btn btn-primary btn-full">Search</button>
          </div>
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div class="form-group">
            <label class="form-label">Date From</label>
            <input type="date" name="date_from" value="<%= @filters[:date_from] %>" class="form-control">
          </div>
          
          <div class="form-group">
            <label class="form-label">Date To</label>
            <input type="date" name="date_to" value="<%= @filters[:date_to] %>" class="form-control">
          </div>
        </div>
      </div>
    </form>
  </div>

  <!-- Audit Logs List -->
  <div class="card">
    <div class="d-flex justify-between align-center mb-4">
      <h2>Activity Log</h2>
      <span class="text-secondary"><%= @total_logs %> entries found</span>
    </div>

    <% if @audit_logs.any? %>
      <div class="audit-timeline">
        <% @audit_logs.each do |log| %>
          <div class="audit-item">
            <div class="timeline-marker"></div>
            <div class="audit-content">
              <div class="audit-header">
                <div class="audit-info">
                  <h3><%= log.action_description %></h3>
                  <p class="text-secondary">
                    by <%= link_to log.user.name, user_path(log.user), class: "text-primary" %>
                    <% if log.resource %>
                      on <%= link_to "#{log.resource_type} ##{log.resource_id}", "#", class: "text-primary" %>
                    <% end %>
                  </p>
                </div>
                <div class="audit-time">
                  <span class="text-secondary"><%= log.created_at.strftime('%B %d, %Y at %I:%M %p') %></span>
                </div>
              </div>
              
              <div class="audit-details">
                <div class="detail-item">
                  <span class="detail-label">Action:</span>
                  <span class="detail-value"><%= log.action.humanize %></span>
                </div>
                <div class="detail-item">
                  <span class="detail-label">Resource:</span>
                  <span class="detail-value"><%= log.resource_type %></span>
                </div>
                <% if log.details['resource_name'] %>
                  <div class="detail-item">
                    <span class="detail-label">Name:</span>
                    <span class="detail-value"><%= log.details['resource_name'] %></span>
                  </div>
                <% end %>
                <div class="detail-item">
                  <span class="detail-label">IP Address:</span>
                  <span class="detail-value"><%= log.ip_address %></span>
                </div>
              </div>
              
              <% if log.details.any? && log.details.except('resource_name', 'ip_address', 'user_agent').any? %>
                <div class="audit-metadata">
                  <h4>Additional Details</h4>
                  <div class="metadata-grid">
                    <% log.details.except('resource_name', 'ip_address', 'user_agent').each do |key, value| %>
                      <div class="metadata-item">
                        <span class="metadata-key"><%= key.humanize %>:</span>
                        <span class="metadata-value"><%= value %></span>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center p-5">
        <h3>No Audit Logs Found</h3>
        <p class="text-secondary">No activity logs match your search criteria.</p>
        <%= link_to "Clear Filters", "/audit_logs", class: "btn btn-outline mt-3" %>
      </div>
    <% end %>
  </div>
</div>

<style>
.audit-timeline {
  position: relative;
  padding-left: 2rem;
}

.audit-timeline::before {
  content: '';
  position: absolute;
  left: 0.5rem;
  top: 0;
  bottom: 0;
  width: 2px;
  background: var(--dark-border);
}

.audit-item {
  position: relative;
  margin-bottom: 2rem;
}

.timeline-marker {
  position: absolute;
  left: -1.5rem;
  top: 1rem;
  width: 1rem;
  height: 1rem;
  border-radius: 50%;
  background: var(--primary-color);
  border: 2px solid var(--dark-bg);
}

.audit-content {
  background: var(--dark-surface);
  border: 1px solid var(--dark-border);
  border-radius: 12px;
  padding: 1.5rem;
  transition: all 0.3s ease;
}

.audit-content:hover {
  border-color: var(--primary-color);
  transform: translateY(-2px);
}

.audit-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1rem;
}

.audit-info h3 {
  font-size: 1.125rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.audit-info p {
  color: var(--text-secondary);
  line-height: 1.4;
  margin: 0;
}

.audit-time {
  text-align: right;
  font-size: 0.875rem;
}

.audit-details {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
  margin-bottom: 1rem;
  padding: 1rem;
  background: var(--dark-bg);
  border-radius: 8px;
}

.detail-item {
  display: flex;
  justify-content: space-between;
  font-size: 0.875rem;
}

.detail-label {
  color: var(--text-secondary);
  font-weight: 500;
}

.detail-value {
  color: var(--text-primary);
  font-weight: 600;
}

.audit-metadata {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--dark-border);
}

.audit-metadata h4 {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 0.75rem;
}

.metadata-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 0.5rem;
}

.metadata-item {
  display: flex;
  justify-content: space-between;
  font-size: 0.75rem;
  padding: 0.25rem 0.5rem;
  background: var(--dark-bg);
  border-radius: 4px;
}

.metadata-key {
  color: var(--text-secondary);
}

.metadata-value {
  color: var(--text-primary);
  font-weight: 500;
}

@media (max-width: 768px) {
  .audit-timeline {
    padding-left: 1rem;
  }
  
  .audit-header {
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .audit-time {
    text-align: left;
  }
  
  .audit-details {
    grid-template-columns: 1fr;
  }
  
  .metadata-grid {
    grid-template-columns: 1fr;
  }
}
</style>
