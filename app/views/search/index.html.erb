<% content_for :title, "Search - NexOps" %>

<div class="container search-page">
  <div class="search-header">
    <h1 class="search-title">Search Results</h1>
    <p class="search-subtitle">
      <% if @query.present? %>
        Showing results for "<%= @query %>"
      <% else %>
        Enter a search query to find operations, targets, findings, and reports
      <% end %>
    </p>
  </div>

  <!-- Search Form -->
  <div class="card">
    <form action="/search" method="get" class="search-form">
      <div class="grid grid-cols-1 gap-4">
        <div class="form-group">
          <label class="form-label">Search Query</label>
          <input type="text" 
                 name="q" 
                 value="<%= @query %>" 
                 class="form-control" 
                 placeholder="Search for operations, targets, findings, reports..."
                 autocomplete="off">
        </div>
        
        <div class="grid grid-cols-2 gap-4">
          <div class="form-group">
            <label class="form-label">Search Type</label>
            <select name="type" class="form-control">
              <option value="global" <%= @search_type == 'global' ? 'selected' : '' %>>Global Search</option>
              <option value="operations" <%= @search_type == 'operations' ? 'selected' : '' %>>Operations Only</option>
              <option value="targets" <%= @search_type == 'targets' ? 'selected' : '' %>>Targets Only</option>
              <option value="findings" <%= @search_type == 'findings' ? 'selected' : '' %>>Findings Only</option>
              <option value="reports" <%= @search_type == 'reports' ? 'selected' : '' %>>Reports Only</option>
            </select>
          </div>
          
          <div class="form-group">
            <button type="submit" class="btn btn-primary btn-full">Search</button>
          </div>
        </div>
      </div>
    </form>
  </div>

  <!-- Filters -->
  <div class="search-filters">
    <div class="filters-header">
      <h3 class="filters-title">Advanced Filters</h3>
      <button class="btn btn-outline btn-sm" onclick="toggleFilters()">Toggle Filters</button>
    </div>
    
    <div id="filters-panel">
      <div class="grid grid-cols-3 gap-4">
        <!-- Operation Filters -->
        <% if @search_type == 'global' || @search_type == 'operations' %>
          <div class="filter-group">
            <label class="filter-label">Operation Status</label>
            <select name="filters[status]" class="filter-select">
              <option value="">All Statuses</option>
              <option value="active" <%= @filters[:status] == 'active' ? 'selected' : '' %>>Active</option>
              <option value="closed" <%= @filters[:status] == 'closed' ? 'selected' : '' %>>Closed</option>
              <option value="planning" <%= @filters[:status] == 'planning' ? 'selected' : '' %>>Planning</option>
            </select>
          </div>
          
          <div class="filter-group">
            <label class="filter-label">Start Date From</label>
            <input type="date" name="filters[start_date]" value="<%= @filters[:start_date] %>" class="filter-select">
          </div>
          
          <div class="filter-group">
            <label class="filter-label">End Date To</label>
            <input type="date" name="filters[end_date]" value="<%= @filters[:end_date] %>" class="filter-select">
          </div>
        <% end %>
        
        <!-- Target Filters -->
        <% if @search_type == 'global' || @search_type == 'targets' %>
          <div class="filter-group">
            <label class="filter-label">IP Address</label>
            <input type="text" name="filters[ip_address]" value="<%= @filters[:ip_address] %>" class="filter-select" placeholder="Partial IP address">
          </div>
        <% end %>
        
        <!-- Finding Filters -->
        <% if @search_type == 'global' || @search_type == 'findings' %>
          <div class="filter-group">
            <label class="filter-label">Severity</label>
            <select name="filters[severity]" class="filter-select">
              <option value="">All Severities</option>
              <option value="critical" <%= @filters[:severity] == 'critical' ? 'selected' : '' %>>Critical</option>
              <option value="high" <%= @filters[:severity] == 'high' ? 'selected' : '' %>>High</option>
              <option value="medium" <%= @filters[:severity] == 'medium' ? 'selected' : '' %>>Medium</option>
              <option value="low" <%= @filters[:severity] == 'low' ? 'selected' : '' %>>Low</option>
            </select>
          </div>
          
          <div class="filter-group">
            <label class="filter-label">Date From</label>
            <input type="date" name="filters[date_from]" value="<%= @filters[:date_from] %>" class="filter-select">
          </div>
          
          <div class="filter-group">
            <label class="filter-label">Date To</label>
            <input type="date" name="filters[date_to]" value="<%= @filters[:date_to] %>" class="filter-select">
          </div>
        <% end %>
        
        <!-- Report Filters -->
        <% if @search_type == 'global' || @search_type == 'reports' %>
          <div class="filter-group">
            <label class="filter-label">Generated From</label>
            <input type="date" name="filters[date_from]" value="<%= @filters[:date_from] %>" class="filter-select">
          </div>
          
          <div class="filter-group">
            <label class="filter-label">Generated To</label>
            <input type="date" name="filters[date_to]" value="<%= @filters[:date_to] %>" class="filter-select">
          </div>
        <% end %>
      </div>
      
      <div class="d-flex gap-3 mt-4">
        <button type="submit" form="search-form" class="btn btn-primary">Apply Filters</button>
        <a href="/search" class="btn btn-outline">Clear Filters</a>
      </div>
    </div>
  </div>

  <!-- Search Results -->
  <div class="search-results">
    <div class="results-header">
      <h2>Results</h2>
      <span class="results-count">
        <% if @query.present? %>
          <%= @results.length %> result<%= @results.length != 1 ? 's' : '' %> found
        <% end %>
      </span>
    </div>
    
    <% if @query.present? %>
      <% if @results.any? %>
        <% @results.each do |result| %>
          <div class="result-item" onclick="window.location.href='<%= result[:url] %>'">
            <div class="result-header">
              <h3 class="result-title"><%= result[:title] %></h3>
              <span class="result-type"><%= result[:type] %></span>
            </div>
            <p class="result-description"><%= result[:description] %></p>
            <div class="result-meta">
              <span>Type: <%= result[:type].capitalize %></span>
              <span>ID: #<%= result[:id] %></span>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="card text-center p-5">
          <h3>No Results Found</h3>
          <p class="text-secondary">No results found for "<%= @query %>". Try adjusting your search terms or filters.</p>
          <%= link_to "Clear Search", "/search", class: "btn btn-outline mt-3" %>
        </div>
      <% end %>
    <% else %>
      <div class="card text-center p-5">
        <h3>Start Searching</h3>
        <p class="text-secondary">Enter a search query above to find operations, targets, findings, and reports.</p>
      </div>
    <% end %>
  </div>

  <!-- Recent Searches -->
  <% if @recent_searches.any? %>
    <div class="recent-searches">
      <h3>Recent Searches</h3>
      <% @recent_searches.each do |search| %>
        <div class="recent-search-item" onclick="window.location.href='/search?q=<%= search.query %>&type=<%= search.search_type %>'">
          <div>
            <div class="recent-search-query"><%= search.query %></div>
            <div class="recent-search-time"><%= search.created_at.strftime('%B %d, %Y at %I:%M %p') %></div>
          </div>
          <span class="badge badge-primary"><%= search.search_type %></span>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<script>
function toggleFilters() {
  const panel = document.getElementById('filters-panel');
  panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
}

// Auto-submit form when filters change
document.querySelectorAll('.filter-select').forEach(select => {
  select.addEventListener('change', function() {
    document.querySelector('.search-form').submit();
  });
});
</script>
