<% content_for :title, "New Target - NexOps" %>

<div class="container">
  <div class="card max-width-800">
    <div class="mb-5">
      <h1>Add New Target</h1>
      <p class="text-secondary">Add a new target to operation: <%= link_to @operation.name, @operation, class: "text-primary" %></p>
    </div>

    <%= form_with(model: [@operation, @target], local: true, class: "target-form") do |form| %>
      <% if @target.errors.any? %>
        <div class="alert alert-danger">
          <h4><%= pluralize(@target.errors.count, "error") %> prohibited this target from being saved:</h4>
          <ul>
            <% @target.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div class="form-group">
          <%= form.label :host_name, class: "form-label" %>
          <%= form.text_field :host_name, class: "form-control", placeholder: "Enter hostname", required: true %>
        </div>

        <div class="form-group">
          <%= form.label :ip_address, class: "form-label" %>
          <%= form.text_field :ip_address, class: "form-control", placeholder: "Enter IP address", required: true %>
        </div>
      </div>

      <div class="form-group mb-4">
        <%= form.label :os, class: "form-label" %>
        <%= form.select :os, 
            options_for_select([
              ['Select OS', ''],
              ['Windows', 'Windows'],
              ['Linux', 'Linux'],
              ['macOS', 'macOS'],
              ['Unix', 'Unix'],
              ['Cisco IOS', 'Cisco IOS'],
              ['Other', 'Other']
            ], @target.os),
            { prompt: 'Select operating system' }, 
            { class: "form-control" } %>
      </div>

      <div class="form-group mb-4">
        <%= form.label :notes, class: "form-label" %>
        <%= form.text_area :notes, class: "form-control", rows: 4, placeholder: "Add any additional notes about this target..." %>
      </div>

      <div class="form-group mb-5">
        <div class="checkbox-wrapper">
          <%= form.check_box :state_compromise, class: "form-checkbox" %>
          <%= form.label :state_compromise, class: "checkbox-label" do %>
            <span class="checkbox-text">Mark as compromised</span>
          <% end %>
        </div>
      </div>

      <div class="form-actions">
        <%= form.submit "Add Target", class: "btn btn-primary" %>
        <%= link_to "Cancel", @operation, class: "btn btn-secondary" %>
      </div>
    <% end %>
  </div>

  <!-- Quick Target Templates -->
  <div class="card mt-5">
    <h2>Quick Target Templates</h2>
    <p class="text-secondary mb-4">Use pre-configured templates for common target types</p>
    
    <div class="grid grid-cols-3">
      <div class="template-card">
        <div class="template-icon">></div>
        <h3>Web Server</h3>
        <p class="text-secondary">Apache/Nginx web server with common ports</p>
        <button class="btn btn-outline btn-sm" onclick="applyTemplate('web')">Use Template</button>
      </div>
      
      <div class="template-card">
        <div class="template-icon">></div>
        <h3>Database Server</h3>
        <p class="text-secondary">MySQL/PostgreSQL database server</p>
        <button class="btn btn-outline btn-sm" onclick="applyTemplate('database')">Use Template</button>
      </div>
      
      <div class="template-card">
        <div class="template-icon">></div>
        <h3>Windows Host</h3>
        <p class="text-secondary">Windows workstation or server</p>
        <button class="btn btn-outline btn-sm" onclick="applyTemplate('windows')">Use Template</button>
      </div>
    </div>
  </div>
</div>

<style>
.max-width-800 {
  max-width: 800px;
  margin: 0 auto;
}

.form-group {
  margin-bottom: 1.5rem;
}

.form-label {
  display: block;
  margin-bottom: 0.5rem;
  font-weight: 600;
  color: var(--text-primary);
  font-size: 0.875rem;
}

.checkbox-wrapper {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.form-checkbox {
  width: 1.25rem;
  height: 1.25rem;
  background: var(--dark-bg);
  border: 1px solid var(--dark-border);
  border-radius: 4px;
  cursor: pointer;
  position: relative;
  transition: all 0.3s ease;
}

.form-checkbox:checked {
  background: var(--gradient-primary);
  border-color: var(--primary-color);
}

.form-checkbox:checked::after {
  content: '';
  position: absolute;
  top: 2px;
  left: 4px;
  width: 4px;
  height: 8px;
  border: solid white;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}

.checkbox-label {
  cursor: pointer;
  margin: 0;
}

.checkbox-text {
  color: var(--text-secondary);
  font-size: 0.875rem;
}

.form-actions {
  border-top: 1px solid var(--dark-border);
  padding-top: 1.5rem;
  margin-top: 2rem;
  display: flex;
  gap: 1rem;
}

.template-card {
  text-align: center;
  padding: 1.5rem;
  border: 1px solid var(--dark-border);
  border-radius: 8px;
  transition: all 0.3s ease;
}

.template-card:hover {
  border-color: var(--primary-color);
  transform: translateY(-2px);
}

.template-icon {
  font-size: 2rem;
  margin-bottom: 1rem;
  opacity: 0.8;
}

.template-card h3 {
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 0.5rem;
}

.template-card p {
  color: var(--text-secondary);
  font-size: 0.875rem;
  margin-bottom: 1rem;
}

@media (max-width: 768px) {
  .grid-cols-2, .grid-cols-3 {
    grid-template-columns: 1fr;
  }
  
  .form-actions {
    flex-direction: column;
  }
}
</style>

<script>
function applyTemplate(type) {
  const templates = {
    web: {
      host_name: 'web-server.example.com',
      ip_address: '192.168.1.100',
      os: 'Linux',
      notes: 'Web server with Apache/Nginx. Common ports: 80, 443, 22, 21'
    },
    database: {
      host_name: 'db-server.example.com',
      ip_address: '192.168.1.200',
      os: 'Linux',
      notes: 'Database server with MySQL/PostgreSQL. Common ports: 3306, 5432, 22'
    },
    windows: {
      host_name: 'win-host.example.com',
      ip_address: '192.168.1.50',
      os: 'Windows',
      notes: 'Windows workstation or server. Common ports: 3389, 445, 135, 139'
    }
  };

  const template = templates[type];
  if (template) {
    document.getElementById('target_host_name').value = template.host_name;
    document.getElementById('target_ip_address').value = template.ip_address;
    document.getElementById('target_os').value = template.os;
    document.getElementById('target_notes').value = template.notes;
  }
}
</script>
