<% content_for :title, "Roles & Permissions - NexOps" %>

<div class="container">
  <div class="d-flex justify-between align-center mb-5">
    <div>
      <h1>Roles & Permissions</h1>
      <p class="text-secondary">Manage user roles and system permissions</p>
    </div>
    <div class="d-flex gap-3">
      <%= link_to "Create Role", new_role_path, class: "btn btn-primary" %>
      <%= link_to "User Management", "#", class: "btn btn-outline" %>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="grid grid-cols-4 mb-5">
    <div class="card stat-card">
      <div class="d-flex align-center gap-3">
        <div class="stat-icon large">></div>
        <div>
          <h2 class="text-primary"><%= @roles.count %></h2>
          <p class="text-secondary">Total Roles</p>
        </div>
      </div>
    </div>
    
    <div class="card stat-card">
      <div class="d-flex align-center gap-3">
        <div class="stat-icon large">></div>
        <div>
          <h2 class="text-success"><%= @total_users %></h2>
          <p class="text-secondary">Total Users</p>
        </div>
      </div>
    </div>
    
    <div class="card stat-card">
      <div class="d-flex align-center gap-3">
        <div class="stat-icon large">></div>
        <div>
          <h2 class="text-warning"><%= @roles.sum { |r| r.users.count } %></h2>
          <p class="text-secondary">Assigned Roles</p>
        </div>
      </div>
    </div>
    
    <div class="card stat-card">
      <div class="d-flex align-center gap-3">
        <div class="stat-icon large">></div>
        <div>
          <h2 class="text-info"><%= Role::PERMISSIONS.count %></h2>
          <p class="text-secondary">Available Permissions</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Roles List -->
  <div class="card">
    <h2>System Roles</h2>
    <div class="roles-grid">
      <% @roles.each do |role| %>
        <div class="role-card">
          <div class="role-header">
            <div class="role-info">
              <h3><%= link_to role.name.capitalize, role_path(role), class: "text-primary" %></h3>
              <p class="text-secondary"><%= role.users.count %> user<%= role.users.count != 1 ? 's' : '' %> assigned</p>
            </div>
            <div class="role-actions">
              <%= link_to "Edit", edit_role_path(role), class: "btn btn-sm btn-outline" %>
              <% if role.users.empty? && !%w[admin operator analyst viewer].include?(role.name) %>
                <%= link_to "Delete", role_path(role), method: :delete, class: "btn btn-sm btn-danger", data: { confirm: "Are you sure you want to delete this role?" } %>
              <% end %>
            </div>
          </div>
          
          <div class="role-permissions">
            <h4>Permissions (<%= role.permissions.count %>)</h4>
            <div class="permissions-list">
              <% role.permissions.first(5).each do |permission| %>
                <span class="permission-badge"><%= permission.humanize %></span>
              <% end %>
              <% if role.permissions.count > 5 %>
                <span class="permission-badge">+<%= role.permissions.count - 5 %> more</span>
              <% end %>
            </div>
          </div>
          
          <div class="role-users">
            <h4>Assigned Users</h4>
            <% if role.users.any? %>
              <div class="users-list">
                <% role.users.limit(3).each do |user| %>
                  <div class="user-item">
                    <div class="user-avatar"><%= user.name.first.upcase %></div>
                    <div class="user-info">
                      <div class="user-name"><%= user.name %></div>
                      <div class="user-email"><%= user.email %></div>
                    </div>
                  </div>
                <% end %>
                <% if role.users.count > 3 %>
                  <div class="more-users">+<%= role.users.count - 3 %> more users</div>
                <% end %>
              </div>
            <% else %>
              <div class="no-users">
                <p class="text-secondary">No users assigned</p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Permission Reference -->
  <div class="card mt-5">
    <h2>Permission Reference</h2>
    <div class="permissions-reference">
      <div class="permission-category">
        <h3>Operations</h3>
        <div class="permission-group">
          <% ['read_operations', 'create_operations', 'update_operations', 'delete_operations', 'close_operations'].each do |perm| %>
            <div class="permission-item">
              <span class="permission-name"><%= perm.humanize %></span>
              <span class="permission-desc">Ability to <%= perm.split('_').first %> operations</span>
            </div>
          <% end %>
        </div>
      </div>
      
      <div class="permission-category">
        <h3>Targets</h3>
        <div class="permission-group">
          <% ['read_targets', 'create_targets', 'update_targets', 'delete_targets', 'scan_targets'].each do |perm| %>
            <div class="permission-item">
              <span class="permission-name"><%= perm.humanize %></span>
              <span class="permission-desc">Ability to <%= perm.split('_').first %> targets</span>
            </div>
          <% end %>
        </div>
      </div>
      
      <div class="permission-category">
        <h3>Findings</h3>
        <div class="permission-group">
          <% ['read_findings', 'create_findings', 'update_findings', 'delete_findings', 'verify_findings'].each do |perm| %>
            <div class="permission-item">
              <span class="permission-name"><%= perm.humanize %></span>
              <span class="permission-desc">Ability to <%= perm.split('_').first %> findings</span>
            </div>
          <% end %>
        </div>
      </div>
      
      <div class="permission-category">
        <h3>Reports</h3>
        <div class="permission-group">
          <% ['read_reports', 'create_reports', 'delete_reports', 'export_reports'].each do |perm| %>
            <div class="permission-item">
              <span class="permission-name"><%= perm.humanize %></span>
              <span class="permission-desc">Ability to <%= perm.split('_').first %> reports</span>
            </div>
          <% end %>
        </div>
      </div>
      
      <div class="permission-category">
        <h3>System</h3>
        <div class="permission-group">
          <% ['manage_users', 'manage_roles', 'view_audit_logs', 'system_admin'].each do |perm| %>
            <div class="permission-item">
              <span class="permission-name"><%= perm.humanize %></span>
              <span class="permission-desc">Ability to <%= perm.split('_').join(' ') %></span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.roles-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
  gap: 1.5rem;
}

.role-card {
  background: var(--dark-surface);
  border: 1px solid var(--dark-border);
  border-radius: 12px;
  padding: 1.5rem;
  transition: all 0.3s ease;
}

.role-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 30px rgba(99, 102, 241, 0.1);
  border-color: var(--primary-color);
}

.role-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1rem;
}

.role-info h3 {
  font-size: 1.125rem;
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.role-info p {
  font-size: 0.875rem;
  margin: 0;
}

.role-actions {
  display: flex;
  gap: 0.5rem;
}

.role-permissions {
  margin-bottom: 1rem;
  padding: 1rem;
  background: var(--dark-bg);
  border-radius: 8px;
}

.role-permissions h4 {
  font-size: 0.875rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
  color: var(--text-primary);
}

.permissions-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.permission-badge {
  background: rgba(99, 102, 241, 0.2);
  color: var(--primary-color);
  padding: 0.25rem 0.5rem;
  border-radius: 12px;
  font-size: 0.75rem;
  font-weight: 500;
}

.role-users {
  padding-top: 1rem;
  border-top: 1px solid var(--dark-border);
}

.role-users h4 {
  font-size: 0.875rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
  color: var(--text-primary);
}

.users-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.user-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.user-avatar {
  width: 2rem;
  height: 2rem;
  background: var(--gradient-primary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  font-weight: 600;
  color: white;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
}

.user-name {
  font-weight: 600;
  color: var(--text-primary);
  font-size: 0.875rem;
}

.user-email {
  font-size: 0.75rem;
  color: var(--text-secondary);
}

.more-users {
  font-size: 0.875rem;
  color: var(--text-secondary);
  text-align: center;
  padding: 0.5rem;
}

.no-users {
  text-align: center;
  padding: 1rem;
}

.permissions-reference {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
}

.permission-category h3 {
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 1rem;
  border-bottom: 1px solid var(--dark-border);
  padding-bottom: 0.5rem;
}

.permission-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.permission-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.5rem;
  background: var(--dark-bg);
  border-radius: 6px;
}

.permission-name {
  font-weight: 600;
  color: var(--text-primary);
  font-size: 0.875rem;
}

.permission-desc {
  color: var(--text-secondary);
  font-size: 0.75rem;
}

@media (max-width: 768px) {
  .roles-grid {
    grid-template-columns: 1fr;
  }
  
  .permissions-reference {
    grid-template-columns: 1fr;
  }
  
  .role-header {
    flex-direction: column;
    gap: 1rem;
  }
  
  .role-actions {
    justify-content: center;
  }
}
</style>
