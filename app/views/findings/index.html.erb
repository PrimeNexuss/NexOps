<% content_for :title, "Findings - NexOps" %>

<div class="container">
  <div class="d-flex justify-between align-center mb-5">
    <div>
      <h1>Security Findings</h1>
      <p class="text-secondary">Track and manage all security findings across operations</p>
    </div>
    <div class="d-flex gap-3">
      <%= link_to "New Finding", "#", class: "btn btn-primary" %>
      <%= link_to "Export Report", "#", class: "btn btn-outline" %>
    </div>
  </div>

  <!-- Statistics Cards -->
  <div class="grid grid-cols-4 mb-5">
    <div class="card stat-card">
      <div class="d-flex align-center gap-3">
        <div class="stat-icon large">></div>
        <div>
          <h2 class="text-primary"><%= @total_findings %></h2>
          <p class="text-secondary">Total Findings</p>
        </div>
      </div>
    </div>
    
    <div class="card stat-card">
      <div class="d-flex align-center gap-3">
        <div class="stat-icon large">></div>
        <div>
          <h2 class="text-danger"><%= @critical_findings %></h2>
          <p class="text-secondary">Critical</p>
        </div>
      </div>
    </div>
    
    <div class="card stat-card">
      <div class="d-flex align-center gap-3">
        <div class="stat-icon large">></div>
        <div>
          <h2 class="text-success"><%= @verified_findings %></h2>
          <p class="text-secondary">Verified</p>
        </div>
      </div>
    </div>
    
    <div class="card stat-card">
      <div class="d-flex align-center gap-3">
        <div class="stat-icon large">></div>
        <div>
          <h2 class="text-warning"><%= @total_findings - @verified_findings %></h2>
          <p class="text-secondary">Pending</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Findings List -->
  <div class="card">
    <div class="d-flex justify-between align-center mb-4">
      <h2>All Findings</h2>
      <div class="d-flex gap-3">
        <select class="form-control" style="width: 120px;">
          <option>All Severities</option>
          <option>Critical</option>
          <option>High</option>
          <option>Medium</option>
          <option>Low</option>
        </select>
        <select class="form-control" style="width: 120px;">
          <option>All Status</option>
          <option>Verified</option>
          <option>Pending</option>
        </select>
        <select class="form-control" style="width: 150px;">
          <option>All Operations</option>
          <% @findings.map(&:operation).uniq.each do |op| %>
            <option><%= op.name %></option>
          <% end %>
        </select>
      </div>
    </div>

    <% if @findings.any? %>
      <div class="findings-timeline">
        <% @findings.each do |finding| %>
          <div class="finding-timeline-item">
            <div class="timeline-marker"></div>
            <div class="finding-card">
              <div class="finding-header">
                <div class="finding-info">
                  <h3><%= link_to finding.title, finding_path(finding), class: "text-primary" %></h3>
                  <p class="text-secondary"><%= finding.description %></p>
                </div>
                <div class="finding-badges">
                  <span class="badge badge-<%= finding.severity == 'critical' ? 'danger' : finding.severity %>"><%= finding.severity.upcase %></span>
                  <% if finding.verified? %>
                    <span class="badge badge-success">Verified</span>
                  <% else %>
                    <span class="badge badge-warning">Pending</span>
                  <% end %>
                </div>
              </div>
              
              <div class="finding-details">
                <div class="finding-meta">
                  <span class="text-secondary">Target:</span>
                  <span><%= link_to finding.target.host_name, finding.target, class: "text-primary" %></span>
                </div>
                <div class="finding-meta">
                  <span class="text-secondary">Operation:</span>
                  <span><%= link_to finding.operation.name, finding.operation, class: "text-primary" %></span>
                </div>
                <div class="finding-meta">
                  <span class="text-secondary">Tool:</span>
                  <span><%= finding.tool&.name || 'Manual' %></span>
                </div>
                <div class="finding-meta">
                  <span class="text-secondary">Evidence:</span>
                  <span><%= finding.evidence.count %> files</span>
                </div>
              </div>
              
              <div class="finding-actions">
                <%= link_to "View Details", finding_path(finding), class: "btn btn-sm btn-outline" %>
                <%= link_to "Edit", edit_finding_path(finding), class: "btn btn-sm btn-secondary" %>
                <% unless finding.verified? %>
                  <%= link_to "Mark Verified", mark_verified_finding_path(finding), method: :patch, class: "btn btn-sm btn-success" %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center p-5">
        <h3>No Findings Yet</h3>
        <p class="text-secondary">Run scans or manually add findings to track security issues.</p>
        <%= link_to "Add Finding", "#", class: "btn btn-primary mt-3" %>
      </div>
    <% end %>
  </div>
</div>

<style>
.findings-timeline {
  position: relative;
  padding-left: 2rem;
}

.findings-timeline::before {
  content: '';
  position: absolute;
  left: 0.5rem;
  top: 0;
  bottom: 0;
  width: 2px;
  background: var(--dark-border);
}

.finding-timeline-item {
  position: relative;
  margin-bottom: 2rem;
}

.timeline-marker {
  position: absolute;
  left: -1.5rem;
  top: 1rem;
  width: 1rem;
  height: 1rem;
  border-radius: 50%;
  background: var(--primary-color);
  border: 2px solid var(--dark-bg);
}

.finding-card {
  background: var(--dark-surface);
  border: 1px solid var(--dark-border);
  border-radius: 12px;
  padding: 1.5rem;
  transition: all 0.3s ease;
}

.finding-card:hover {
  border-color: var(--primary-color);
  transform: translateY(-2px);
}

.finding-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1rem;
}

.finding-info h3 {
  font-size: 1.125rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
}

.finding-info p {
  color: var(--text-secondary);
  line-height: 1.4;
  margin: 0;
}

.finding-badges {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.finding-details {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
  margin-bottom: 1rem;
}

.finding-meta {
  display: flex;
  justify-content: space-between;
  font-size: 0.875rem;
}

.finding-actions {
  display: flex;
  gap: 0.5rem;
  padding-top: 1rem;
  border-top: 1px solid var(--dark-border);
}

@media (max-width: 768px) {
  .findings-timeline {
    padding-left: 1rem;
  }
  
  .finding-header {
    flex-direction: column;
    gap: 1rem;
  }
  
  .finding-badges {
    flex-direction: row;
  }
  
  .finding-details {
    grid-template-columns: 1fr;
  }
  
  .finding-actions {
    flex-wrap: wrap;
  }
}
</style>
