<% content_for :title, "Edit Finding - NexOps" %>

<div class="page-header">
  <div class="header-content">
    <h1 class="page-title">Edit Finding</h1>
    <p class="page-subtitle">Update security finding details</p>
  </div>
</div>

<div class="content-container">
  <div class="card">
    <div class="card-header">
      <h3>Security Finding Details</h3>
    </div>
    <div class="card-body">
      <%= form_with(model: @finding, local: true, class: "form") do |f| %>
        <%= render 'shared/error_messages', object: @finding %>
        
        <div class="form-row">
          <div class="form-group col-md-6">
            <%= f.label :title, class: "form-label" %>
            <%= f.text_field :title, class: "form-control", placeholder: "Enter finding title", required: true %>
          </div>
          
          <div class="form-group col-md-6">
            <%= f.label :severity, class: "form-label" %>
            <%= f.select :severity, 
                options_for_select([['Critical', 'critical'], ['High', 'high'], ['Medium', 'medium'], ['Low', 'low']]),
                { prompt: "Select severity" },
                { class: "form-control", required: true } %>
          </div>
        </div>
        
        <div class="form-group">
          <%= f.label :description, class: "form-label" %>
          <%= f.text_area :description, class: "form-control", rows: 4, 
              placeholder: "Describe the security finding in detail", required: true %>
        </div>
        
        <div class="form-row">
          <div class="form-group col-md-6">
            <%= f.label :tool_id, class: "form-label" %>
            <%= f.collection_select :tool_id, Tool.all, :id, :name, 
                { prompt: "Select tool (optional)" }, 
                { class: "form-control" } %>
          </div>
          
          <div class="form-group col-md-6">
            <%= f.label :verified, class: "form-label" %>
            <div class="checkbox-wrapper">
              <%= f.check_box :verified, class: "form-checkbox" %>
              <%= f.label :verified, "Mark as verified", class: "checkbox-label" %>
            </div>
          </div>
        </div>
        
        <div class="form-group">
          <%= f.label :recommendation, class: "form-label" %>
          <%= f.text_area :recommendation, class: "form-control", rows: 3,
              placeholder: "Provide recommendations for remediation" %>
        </div>
        
        <div class="form-actions">
          <%= f.submit "Update Finding", class: "btn btn-primary" %>
          <%= link_to "Cancel", @finding, class: "btn btn-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
  
  <div class="target-info">
    <div class="card">
      <div class="card-header">
        <h4>Finding Information</h4>
      </div>
      <div class="card-body">
        <p><strong>Target:</strong> <%= @finding.target.host_name %></p>
        <p><strong>IP Address:</strong> <%= @finding.target.ip_address %></p>
        <p><strong>Operation:</strong> <%= @finding.operation.name %></p>
        <p><strong>Created:</strong> <%= @finding.created_at.strftime('%Y-%m-%d %H:%M') %></p>
      </div>
    </div>
  </div>
</div>
